# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/skincare_app?schema=public"

# JWT
JWT_SECRET="change-this-access-token-secret"
JWT_REFRESH_SECRET="change-this-refresh-token-secret"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# Patient OTP login. The backend generates the 6-digit code itself. With no
# SMS provider wired up yet, the code is returned in the send-otp response
# and the app shows it on screen. Set to false once real SMS delivery exists.
OTP_SHOW_IN_RESPONSE=true

# Firebase Admin SDK (phone login, FCM push notifications, Storage uploads).
# Not required to run the server - without these, push falls back to the
# console-log stub in services/fcm.js, uploads fall back to Cloudinary/local
# disk, and patient login falls back to the dev OTP endpoints.
# Either point at a downloaded service-account JSON file...
FIREBASE_SERVICE_ACCOUNT_PATH=
# ...or set these three (used only when the path above is empty). On Railway
# paste the private key on one line with literal backslash-n escapes, quoted.
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
# Cloud Storage bucket for uploads. Defaults to "<project-id>.firebasestorage.app".
FIREBASE_STORAGE_BUCKET=

# Agora (video calls).
# Not required to run the server - services/agora.js falls back to a
# placeholder token whenever these are missing/empty.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Cloudinary (media uploads: case photos, prescription attachments, avatars).
# Not required to run the server - routes/upload.routes.js falls back to
# local disk storage (backend/uploads/) whenever these are missing/empty.
# Find these on the Cloudinary dashboard under Settings > API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
